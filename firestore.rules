rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(data) {
      return data.drugstoreId == request.auth.uid || data.authorId == request.auth.uid;
    }

    // Drugstore rules
    match /drugstores/{drugstoreId} {
      allow read: if isSignedIn() && (drugstoreId == request.auth.uid || (resource != null && resource.data.ownerId == request.auth.uid));
      allow create: if isSignedIn() && isEmailVerified() && request.resource.data.ownerId == request.auth.uid && drugstoreId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false; 
    }

    // Professionals rules (belong to a drugstore)
    match /professionals/{professionalId} {
      allow read, write: if isSignedIn() && (resource == null || isOwner(resource.data) || isOwner(request.resource.data));
    }

    // POPs rules
    match /pops/{popId} {
      allow read: if isSignedIn() && (resource != null && isOwner(resource.data));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data);
      allow update: if isSignedIn() && isOwner(resource.data);
      allow delete: if isSignedIn() && isOwner(resource.data);
    }

    // System Templates (Public Read)
    match /popTemplates/{templateId} {
      allow read: if isSignedIn();
    }
    match /formTemplates/{templateId} {
      allow read: if isSignedIn();
    }

    // Revision history
    match /revisions/{revisionId} {
      function getPop(popId) {
        return get(/databases/$(database)/documents/pops/$(popId)).data;
      }
      function getDrugstore(drugstoreId) {
        return get(/databases/$(database)/documents/drugstores/$(drugstoreId)).data;
      }

      allow read: if isSignedIn() && getDrugstore(getPop(resource.data.popId).drugstoreId).ownerId == request.auth.uid;
      allow create: if isSignedIn() && isEmailVerified() && getDrugstore(getPop(request.resource.data.popId).drugstoreId).ownerId == request.auth.uid;
    }
  }
}
