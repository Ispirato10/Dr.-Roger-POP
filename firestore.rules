rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // POPs rules
    match /pops/{popId} {
      allow read, write: if isSignedIn() && (
        resource == null || 
        resource.data.drugstoreId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.drugstoreId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // Drugstore rules
    match /drugstores/{drugstoreId} {
      allow read, write: if isSignedIn() && (drugstoreId == request.auth.uid || (resource != null && resource.data.ownerId == request.auth.uid));
      allow delete: if false; 
    }

    // Professionals rules
    match /professionals/{professionalId} {
      allow read, write: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // System Templates (Public Read)
    match /popTemplates/{templateId} {
      allow read: if isSignedIn();
    }
    match /formTemplates/{templateId} {
      allow read: if isSignedIn();
    }

    // Revision history
    match /revisions/{revisionId} {
      allow read, write: if isSignedIn();
    }

    // Default deny at the bottom
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
